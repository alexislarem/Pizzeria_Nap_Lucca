# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=https://tudominio.com

# ── Base de datos (Neon Postgres) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Los formularios de /reservar y /contacto envían un email a RESEND_TO_EMAIL.
# FROM debe ser de un dominio verificado en Resend (en pruebas: onboarding@resend.dev).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="LUCA web <hola@tudominio.com>"
RESEND_TO_EMAIL=lucafenap@gmail.com

# ── Anti-spam (Cloudflare Turnstile) ─────────────────────────────────────────
# Claves de PRUEBA de Cloudflare (siempre aprueban) para desarrollo local:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_* se incrusta al compilar: tras cambiarla, vuelve a hacer build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# ── Rate limit (Upstash Redis) ────────────────────────────────────────────────
# Máximo 5 envíos cada 10 min por IP y formulario (lib/server/rate-limit.ts).
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
