# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=https://lucapizzerianapoletana.es

# ── Base de datos (Neon Postgres) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Contacto y reseñas envían un email a RESEND_TO_EMAIL; al publicar una reseña, otro a su autor.
# FROM debe ser de un dominio verificado en Resend (en pruebas: onboarding@resend.dev).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="LUCA web <web@lucapizzerianapoletana.es>"
RESEND_TO_EMAIL=lucafenap@gmail.com

# ── Anti-spam (Cloudflare Turnstile) ─────────────────────────────────────────
# Claves de PRUEBA de Cloudflare (siempre aprueban) para desarrollo local:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_* se incrusta al compilar: tras cambiarla, vuelve a hacer build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# ── Rate limit (Upstash Redis) ────────────────────────────────────────────────
# Máximo 5 envíos cada 10 min por IP y formulario (lib/server/rate-limit.ts).
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Reseñas (moderación por email) ───────────────────────────────────────────
# Clave secreta con la que se firman los botones "Publicar / Rechazar" del email.
# Generar una (64 caracteres):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia, los enlaces de los emails ya enviados dejan de funcionar.
REVIEW_SIGNING_SECRET=
# Fotos de las reseñas publicadas. Vercel → Storage → Create → Blob (conectar al proyecto)
# crea BLOB_STORE_ID; en Vercel la autenticación es automática (token OIDC).
# En local: `vercel env pull .env.local` (trae BLOB_STORE_ID y VERCEL_OIDC_TOKEN).
BLOB_STORE_ID=store_...
